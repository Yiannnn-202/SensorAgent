{
  "name": "robot.stop",
  "version": "0.1.0",
  "description": "Stop active robot and gripper motion.",
  "input_schema": {
    "type": "object",
    "properties": {}
  },
  "output_schema": {
    "type": "object",
    "required": ["completed", "message", "state"],
    "properties": {
      "completed": {"type": "boolean"},
      "message": {"type": "string"},
      "state": {"type": "object"}
    }
  },
  "errors": ["ROBOT_UNAVAILABLE", "STOP_FAILED"]
}
