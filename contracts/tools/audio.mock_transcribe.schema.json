{
  "name": "audio.mock_transcribe",
  "version": "0.1.0",
  "description": "Mock ASR tool. It returns deterministic text for local tests.",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Optional text override used by the mock transcriber."
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["text", "confidence", "language"],
    "properties": {
      "text": {
        "type": "string"
      },
      "confidence": {
        "type": "number"
      },
      "language": {
        "type": "string"
      }
    }
  },
  "errors": [
    "TRANSCRIBE_FAILED"
  ]
}
