{
  "name": "gripper.open",
  "version": "0.1.0",
  "description": "Open the gripper to a requested opening in metres.",
  "input_schema": {
    "type": "object",
    "properties": {
      "opening": {"type": "number"},
      "speed": {"type": "number"}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["completed", "message", "state"],
    "properties": {
      "completed": {"type": "boolean"},
      "message": {"type": "string"},
      "state": {"type": "object"}
    }
  },
  "errors": ["INVALID_GRIPPER_OPENING", "GRIPPER_FAILED", "GRIPPER_TIMEOUT"]
}
