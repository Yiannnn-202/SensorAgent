{
  "name": "robot.mock_place",
  "version": "0.1.0",
  "description": "Mock robot place tool. It simulates a successful object placement.",
  "input_schema": {
    "type": "object",
    "required": ["object_id", "target"],
    "properties": {
      "object_id": {
        "type": "string"
      },
      "target": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["placed", "target", "execution_id"],
    "properties": {
      "placed": {
        "type": "boolean"
      },
      "target": {
        "type": "string"
      },
      "execution_id": {
        "type": "string"
      }
    }
  },
  "errors": [
    "PLACE_FAILED",
    "TARGET_UNAVAILABLE"
  ]
}
