<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_dep</name>
  <version>0.0.0</version>
  <description>Depth camera node using RealSense D435 with JPEG-compressed streaming</description>
  <maintainer email="ashexlv278@gmail.com">nvidia</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>tf2_ros</depend>
  <depend>rm_ros_interfaces</depend>
  <depend>vision_interfaces</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-httpx</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <depend>rosbridge_server</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <build_depend>librealsense2-dev</build_depend>
  <build_depend>libturbojpeg</build_depend>
  <exec_depend>librealsense2</exec_depend>
  <exec_depend>libturbojpeg</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
