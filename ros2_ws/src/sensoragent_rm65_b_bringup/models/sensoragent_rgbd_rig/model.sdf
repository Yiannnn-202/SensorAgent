<?xml version="1.0"?>
<sdf version="1.8">
  <model name="sensoragent_rgbd_rig">
    <static>true</static>
    <link name="rig">
      <visual name="left_post">
        <pose>0.34 0.50 0.57 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.14</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <collision name="left_post_collision">
        <pose>0.34 0.50 0.57 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.14</size></box></geometry>
      </collision>
      <visual name="right_post">
        <pose>0.34 -0.50 0.57 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.14</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <collision name="right_post_collision">
        <pose>0.34 -0.50 0.57 0 0 0</pose>
        <geometry><box><size>0.04 0.04 1.14</size></box></geometry>
      </collision>
      <visual name="crossbar">
        <pose>0.34 0 1.12 0 0 0</pose>
        <geometry><box><size>0.05 1.04 0.05</size></box></geometry>
        <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <collision name="crossbar_collision">
        <pose>0.34 0 1.12 0 0 0</pose>
        <geometry><box><size>0.05 1.04 0.05</size></box></geometry>
      </collision>
      <visual name="camera_body">
        <pose>0.34 0 1.08 0 0 0</pose>
        <geometry><box><size>0.10 0.06 0.04</size></box></geometry>
        <material><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>

      <sensor name="rgb_camera" type="camera">
        <pose>0.34 0 1.06 0 1.570796 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/industrial_camera/image</topic>
        <camera>
          <camera_info_topic>/industrial_camera/camera_info</camera_info_topic>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>424</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>3.0</far>
          </clip>
        </camera>
      </sensor>

      <sensor name="depth_camera" type="depth_camera">
        <pose>0.34 0 1.06 0 1.570796 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/industrial_camera/depth_image</topic>
        <camera>
          <camera_info_topic>/industrial_camera/depth_camera_info</camera_info_topic>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>424</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.10</near>
            <far>3.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
