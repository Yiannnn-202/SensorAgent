# Local model weights and runtime assets. Keep directory structure and docs.
/models/**/*
!/models/**/
!/models/**/.gitkeep
!/models/**/README.md
!/models/vision/metadata/*.json

# Weights auto-downloaded into the working directory (Ultralytics writes
# sam2_t.pt / yolo*.pt to the CWD, not to models/). YOLOE also fetches its
# MobileCLIP text encoder as a TorchScript .ts file.
*.pt
*.pth
*.safetensors
*.onnx
mobileclip_*.ts

