# Runtime logs
logs/

# Local model weights and runtime assets. Keep directory structure and docs.
/models/**/*
!/models/**/
!/models/**/.gitkeep
!/models/**/README.md

# Weights auto-downloaded into the working directory (Ultralytics writes
# sam2_t.pt / yolo*.pt to the CWD, not to models/).
*.pt
*.pth
*.safetensors
*.onnx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
.venv-*/
venv/

# Local environment
.env
.env.*
!.env.example

# Build outputs
build/
dist/

# ROS 2 / colcon outputs
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Locally imported RealMan files (upstream redistribution license is unclear)
ros2_ws/src/rm_description/*
!ros2_ws/src/rm_description/.gitkeep
ros2_ws/src/rm_gazebo/*
!ros2_ws/src/rm_gazebo/.gitkeep
ros2_ws/src/rm_65_config/*
!ros2_ws/src/rm_65_config/.gitkeep

# Reinforcement learning runtime artifacts
reinforcement_learning/checkpoints/
reinforcement_learning/datasets/
reinforcement_learning/runs/
