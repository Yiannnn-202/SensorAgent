# SensorAgent runtime environment
SENSORAGENT_ENV=competition_sim
SENSORAGENT_CONFIG=configs/competition_sim.yaml

# LLM provider
SENSORAGENT_LLM_PROVIDER=deepseek
SENSORAGENT_LLM_BASE_URL=https://api.deepseek.com
SENSORAGENT_LLM_API_KEY=replace-me
SENSORAGENT_LLM_MODEL=deepseek-v4-flash

# Optional VLM provider for hardware candidate reference resolution.
SENSORAGENT_VLM_PROVIDER=kimi
SENSORAGENT_VLM_BASE_URL=https://api.moonshot.cn/v1
SENSORAGENT_VLM_API_KEY=replace-me
SENSORAGENT_VLM_MODEL=replace-me
SENSORAGENT_VLM_TIMEOUT_SECONDS=90

# Logging
SENSORAGENT_LOG_DIR=logs
SENSORAGENT_LOG_LEVEL=info
